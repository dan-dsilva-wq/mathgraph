{
  "project": {
    "name": "MathGraph",
    "description": "Interactive 3D math visualization tool",
    "techStack": "Next.js 16 + TypeScript + Three.js + KaTeX",
    "visionFile": "product-vision.txt"
  },
  "qualityGates": {
    "enabled": true,
    "commands": {
      "typecheck": "npx tsc --noEmit",
      "lint": "npx eslint",
      "build": "npm run build"
    }
  },
  "git": {
    "mainBranch": "main",
    "branchPrefix": "experimental/overnight"
  },
  "safety": {
    "maxFilesPerTask": 10,
    "maxConsecutiveFailures": 3,
    "maxConsecutiveNoOps": 3,
    "blockedPatterns": [
      "\\.env", "package-lock\\.json", "yarn\\.lock",
      "pnpm-lock\\.yaml", "node_modules/",
      "\\.secret", "credentials"
    ]
  },
  "timing": {
    "pauseSeconds": 30,
    "maxRetries": 3
  }
}
